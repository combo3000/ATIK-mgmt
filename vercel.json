{
  "functions": {
    "api/telegram.js": {
      "includeFiles": "index.html"
    },
    "api/telegram-weekly.js": {
      "includeFiles": "index.html"
    },
    "api/telegram-backup.js": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/telegram-weekly",
      "schedule": "0 6 * * 1"
    },
    {
      "path": "/api/telegram-backup",
      "schedule": "0 19 * * 0"
    }
  ]
}
